#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int global = 0;

void greetuser(char *buf_1) {
	char	greetuser_buf[72];
	
	if (global == 1)
		strcpy(greetuser_buf, "Hyvää päivää ");
	else if (global == 2)
		strcpy(greetuser_buf, "Goedemiddag! ");
	else
		strcpy(greetuser_buf, "Hello ");

	strcat(greetuser_buf, buf_1);
	puts(greetuser_buf);
}

int main(int argc, char **argv) {
	if (argc == 3) {
		char	buf_1[40];
		char	buf_2[32];
		char	*lang;

		strncpy(buf_1, argv[1], 40);
		strncpy(buf_2, argv[2], 32);

		lang = getenv("LANG");
		if (memcmp(lang, "fi", 2) == 0)
			global = 1;
		else if (memcmp(lang, "nl", 2) == 0)
			global = 2;

		greetuser(buf_1);
	}
	
	return (0);
}